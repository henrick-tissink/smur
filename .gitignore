# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright MCP cache (snapshots, console logs from in-session debugging)
.playwright-mcp/

# Ad-hoc debug screenshots dropped at the repo root during dev (e.g.
# Playwright captures used to verify layout changes). Keep Figma reference
# images committed via the .figma-ref/ directory; everything else stays local.
/*.png

# playwright test artifacts
/.playwright-mcp/
/test-results/

# Raw asset drops from the client (PNGs/SVGs uploaded into the repo root).
# What we use gets copied into public/figma-assets; the originals stay local.
/EXPORTS SMUR WEBSITE/

# Local-only drafts (WhatsApp messages, etc.)
/docs/whatsapp-to-smaranda.md
